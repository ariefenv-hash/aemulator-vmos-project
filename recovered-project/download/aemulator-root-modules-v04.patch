diff --git a/app/src/main/java/app/aemu/core/SuDaemon.kt b/app/src/main/java/app/aemu/core/SuDaemon.kt
new file mode 100644
index 0000000..0e7da80
--- /dev/null
+++ b/app/src/main/java/app/aemu/core/SuDaemon.kt
@@ -0,0 +1,285 @@
+package app.aemu.core
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlin.concurrent.thread
+
+/**
+ * Root for guest apps, the VMOS way, but without a kernel: the guest tree ships a plain `su` script (written into
+ * /system/bin, /system/xbin and /sbin by [seedGuestFiles] before the services start), and every call of it drops a
+ * request file into /data/aemu-su/req. This host-side daemon picks the request up, resolves the caller's package,
+ * applies the superuser policy (master switch, default policy, per-app allow/deny — edited by the UI panel) and, if
+ * granted, runs the command as a fresh guest process — which the engine starts with uid 0, the same way it starts
+ * init services — and writes the output back into /data/aemu-su/resp, from where the script prints it and exits
+ * with the recorded code.
+ *
+ * The request/response files make the protocol work on every engine (QEMU 2.3–4.4 and the native arm64 one) and
+ * need no new sockets: the guest writes a plain file, the daemon answers with two more (output + exit code, renamed
+ * into place atomically so the script never sees a half-written answer).
+ */
+class SuDaemon(private val vm: GuestVm) {
+
+    data class Entry(val t: Long, val pkg: String, val uid: Int, val cmd: String, val ok: Boolean, val allowed: Boolean)
+
+    /** An "ask" decision surfaced to the UI; [respond] completes the request either way. */
+    class Ask(val pkg: String, val uid: Int, val cmd: String, val respond: (Boolean) -> Unit)
+
+    /** Set by the activity; when the "ask" policy is in effect, the request pops a dialog there. */
+    @Volatile var onRequest: ((Ask) -> Unit)? = null
+
+    private val storeFile: File get() = File(vm.paths.bin, "superuser.json")
+    private var enabled = true
+    private var defaultPolicy = "allow"                       // allow | ask | deny
+    private val apps = LinkedHashMap<String, String>()        // package → allow | deny
+    private val log = ArrayDeque<Entry>()
+    @Volatile private var running = false
+    private var uidCache: Pair<Long, Map<Int, String>> = 0L to emptyMap()
+
+    init { load() }
+
+    // ------------------------------------------------------------------ policy store
+
+    @Synchronized private fun load() {
+        runCatching {
+            val o = JSONObject(storeFile.takeIf { it.isFile }?.readText() ?: "{}")
+            enabled = o.optBoolean("enabled", true)
+            defaultPolicy = o.optString("default", "allow")
+            apps.clear()
+            o.optJSONObject("apps")?.let { a -> a.keys().forEach { k -> apps[k] = a.optString(k, "deny") } }
+            log.clear()
+            o.optJSONArray("log")?.let { arr ->
+                for (i in 0 until arr.length()) {
+                    val e = arr.optJSONObject(i) ?: continue
+                    log.addLast(Entry(e.optLong("t"), e.optString("pkg"), e.optInt("uid"), e.optString("cmd"), e.optBoolean("ok"), e.optBoolean("allowed")))
+                }
+            }
+        }
+    }
+
+    @Synchronized private fun save() {
+        runCatching {
+            val o = JSONObject()
+            o.put("enabled", enabled)
+            o.put("default", defaultPolicy)
+            val a = JSONObject()
+            for ((k, v) in apps) a.put(k, v)
+            o.put("apps", a)
+            val arr = JSONArray()
+            for (e in log) arr.put(JSONObject().put("t", e.t).put("pkg", e.pkg).put("uid", e.uid).put("cmd", e.cmd).put("ok", e.ok).put("allowed", e.allowed))
+            o.put("log", arr)
+            storeFile.writeText(o.toString(2))
+        }
+    }
+
+    data class SuStore(val enabled: Boolean, val default: String, val apps: Map<String, String>, val log: List<Entry>)
+
+    @Synchronized fun store(): SuStore = SuStore(enabled, defaultPolicy, apps.toMap(), log.toList())
+    @Synchronized fun setEnabled(v: Boolean) {
+        enabled = v; save()
+        // the guest tree follows the switch right away: no su binaries while root is off (the VMOS semantics)
+        seedGuestFiles()
+        vm.log("su: root ${if (v) "enabled" else "disabled"}")
+    }
+    @Synchronized fun setDefault(p: String) { defaultPolicy = p; save() }
+    @Synchronized fun setApp(pkg: String, policy: String) { if (policy == "ask") apps.remove(pkg) else apps[pkg] = policy; save() }
+    @Synchronized fun clearLog() { log.clear(); save() }
+
+    /** Whether a request from [pkg] runs without asking: allow/deny, or null when the UI has to decide ("ask"). */
+    @Synchronized fun decide(pkg: String): Boolean? {
+        if (!enabled) return false
+        return when (apps[pkg] ?: defaultPolicy) { "allow" -> true; "deny" -> false; else -> null }
+    }
+
+    @Synchronized private fun record(pkg: String, uid: Int, cmd: String, ok: Boolean, allowed: Boolean) {
+        log.addLast(Entry(System.currentTimeMillis(), pkg, uid, cmd.take(160), ok, allowed))
+        while (log.size > 100) log.removeFirst()
+        save()
+    }
+
+    // ------------------------------------------------------------------ uid → package
+
+    /** `pm list packages -U` of the guest, cached for 10 minutes (5.0+; older firmwares fall back to "uidN"). */
+    private fun uidName(uid: Int): String {
+        val (at, map) = uidCache
+        var map2 = map
+        if (System.currentTimeMillis() - at > 600_000 || uid !in map) {
+            map2 = runCatching {
+                vm.guestShell("pm list packages -U", 90_000).lines().mapNotNull {
+                    val m = Regex("""package:(\S+)\s+uid:(\d+)""").find(it.trim()) ?: return@mapNotNull null
+                    m.groupValues[2].toInt() to m.groupValues[1]
+                }.toMap()
+            }.getOrDefault(map)
+            uidCache = System.currentTimeMillis() to map2
+        }
+        return map2[uid] ?: "uid$uid"
+    }
+
+    // ------------------------------------------------------------------ daemon
+
+    fun start() {
+        if (running) return
+        running = true
+        val resp = File(vm.paths.root, "data/aemu-su/resp")
+        // answers of requests whose script is long gone (VM stopped mid-command)
+        runCatching { resp.listFiles()?.forEach { if (System.currentTimeMillis() - it.lastModified() > 3_600_000) it.delete() } }
+        daemonMarker().writeText("running")
+        thread(name = "su-daemon", isDaemon = true) {
+            val req = File(vm.paths.root, "data/aemu-su/req")
+            while (running) {
+                val now = System.currentTimeMillis()
+                for (f in req.listFiles().orEmpty()) {
+                    if (!f.isFile || now - f.lastModified() < 300) continue   // let the writer finish
+                    val text = runCatching { f.readText() }.getOrDefault("")
+                    val id = f.name
+                    runCatching { f.delete() }
+                    val uid = Regex("""^uid=(\d+)""").find(text)?.groupValues?.get(1)?.toIntOrNull() ?: 0
+                    val cmd = Regex("""\scmd=(.*)$""", RegexOption.DOT_MATCHES_ALL).find(text)?.groupValues?.get(1)?.trim().orEmpty()
+                    if (cmd.isEmpty()) { vm.log("su: unreadable request dropped"); continue }
+                    answer(id, uid, cmd)
+                }
+                Thread.sleep(250)
+            }
+        }
+        vm.log("su: daemon started (root ${if (enabled) "enabled, default $defaultPolicy" else "disabled"})")
+    }
+
+    fun stop() {
+        running = false
+        runCatching { daemonMarker().delete() }
+    }
+
+    /** the guest's su script exits at once (instead of waiting) when this file is gone */
+    private fun daemonMarker(): File = File(vm.paths.root, "data/aemu-su/.daemon")
+
+    /** commands run one at a time: every su command is a full guest process, and a pile of them
+     *  would squeeze the host (the DNS proxy and the services live in this same app process) */
+    private val queue = java.util.concurrent.LinkedBlockingQueue<Runnable>()
+    @Volatile private var worker: Thread? = null
+
+    private fun enqueue(r: Runnable) {
+        synchronized(queue) {
+            queue.put(r)
+            if (worker?.isAlive != true) {
+                worker = thread(name = "su-worker", isDaemon = true) {
+                    try { while (true) { queue.take().run() } } catch (e: InterruptedException) { }
+                }
+            }
+        }
+    }
+
+    private fun answer(id: String, uid: Int, cmd: String) {
+        enqueue {
+            val pkg = uidName(uid)
+            val d = decide(pkg)
+            if (d == null) askWith(id, pkg, uid, cmd) else respond(id, pkg, uid, cmd, d)
+        }
+    }
+
+    /** a full round trip through the guest: the UI "Test root" button */
+    fun testRoot(): Pair<Boolean, String> {
+        val r = runCatching { vm.guestRunner.run(listOf("/system/bin/sh", "-c", vm.shellPrefix + "su -c id"), 60_000) }
+            .getOrElse { -1 to (it.message ?: "error") }
+        val ok = r.first == 0 && r.second.contains("uid=0")
+        val out = r.second.trim().lines().firstOrNull { it.isNotBlank() } ?: "(no output)"
+        return ok to out
+    }
+
+    /** The "ask" path: pop the dialog in the UI; 60 s of silence counts as a deny. */
+    private fun askWith(id: String, pkg: String, uid: Int, cmd: String) {
+        val done = AtomicBoolean(false)
+        val cb = { ok: Boolean ->
+            if (done.compareAndSet(false, true)) respond(id, pkg, uid, cmd, ok)
+        }
+        val handler = onRequest
+        if (handler == null) { cb(false); return }
+        val ask = Ask(pkg, uid, cmd, cb)
+        handler(ask)
+        thread(name = "su-ask-timeout", isDaemon = true) {
+            Thread.sleep(60_000)
+            cb(false)
+        }
+    }
+
+    private fun respond(id: String, pkg: String, uid: Int, cmd: String, allowed: Boolean) {
+        val resp = File(vm.paths.root, "data/aemu-su/resp")
+        resp.mkdirs()
+        if (!allowed) {
+            writeResp(resp, id, "su: $pkg is not allowed to run root commands\n", 1)
+            record(pkg, uid, cmd, ok = false, allowed = false)
+            vm.log("su: denied $pkg: ${cmd.take(60)}")
+            return
+        }
+        val r = runCatching {
+            vm.guestRunner.run(listOf("/system/bin/sh", "-c", vm.shellPrefix + cmd), 600_000)
+        }.getOrElse { -1 to "su: ${it.message}" }
+        writeResp(resp, id, r.second.ifEmpty { "(no output)" }, r.first)
+        record(pkg, uid, cmd, ok = r.first == 0, allowed = true)
+        vm.log("su: $pkg ran ${cmd.take(60)} → exit ${r.first}")
+    }
+
+    private fun writeResp(resp: File, id: String, out: String, code: Int) {
+        runCatching {
+            val o = File(resp, "$id.out.tmp"); o.writeText(out); o.setReadable(true, false)
+            File(resp, "$id.out").delete(); o.renameTo(File(resp, "$id.out"))
+            val r = File(resp, "$id.ret.tmp"); r.writeText("ret=$code\n"); r.setReadable(true, false)
+            File(resp, "$id.ret").delete(); r.renameTo(File(resp, "$id.ret"))
+        }
+    }
+
+    // ------------------------------------------------------------------ guest tree
+
+    /** The `su` script the guest sees, and the request/response folders it uses. Called before the services start. */
+    fun seedGuestFiles() {
+        val root = vm.paths.root
+        runCatching {
+            val req = File(root, "data/aemu-su/req"); req.mkdirs()
+            val resp = File(root, "data/aemu-su/resp"); resp.mkdirs()
+            for (d in listOf(req, resp)) { d.setReadable(true, false); d.setWritable(true, false); d.setExecutable(true, false) }
+        }
+        // root off (or the VM not running) → no su binaries in the guest at all: the switch is what a
+        // root-checker sees, and nothing extra is lying in /system for PackageManager to scan at boot
+        val suFiles = listOf("system/bin/su", "system/xbin/su", "sbin/su")
+        if (!enabled) {
+            for (p in suFiles) runCatching { File(root, p).delete() }
+            runCatching { File(root, "system/app/Superuser.apk").delete() }   // never shipped again, clean up after older builds
+            runCatching { daemonMarker().delete() }
+            return
+        }
+        val script = suScript()
+        for (p in suFiles) runCatching {
+            val f = File(root, p)
+            f.parentFile?.mkdirs()
+            f.writeText(script)
+            f.setReadable(true, false); f.setExecutable(true, false)
+        }
+    }
+
+    private fun suScript() = """#!/system/bin/sh
+# AEmulator su: the host-side daemon runs the command as uid 0 (see core/SuDaemon.kt)
+D=/data/aemu-su
+MYUID=$(id 2>/dev/null || echo "uid=0")
+[ -f "${'$'}D/.daemon" ] || { echo "su: daemon is not running (root is off or the VM is stopped)"; exit 4; }
+CMD=
+if [ "${'$'}1" = "root" ] || [ "${'$'}1" = "0" ]; then shift; fi
+if [ "${'$'}1" = "-c" ]; then shift; fi
+for a in "${'$'}@"; do CMD="${'$'}CMD ${'$'}a"; done
+CMD=${'$'}{CMD# }
+[ -n "${'$'}CMD" ] || { echo "su: nothing to run (usage: su -c <command>)"; exit 2; }
+ID="${'$'}${'$'}.$(date +%s)"
+R="${'$'}D/req/${'$'}ID"
+echo "uid=${'$'}{MYUID#uid=} cmd=${'$'}CMD" > "${'$'}R" 2>/dev/null || { echo "su: cannot write the request"; exit 3; }
+n=0
+while [ ! -f "${'$'}D/resp/${'$'}ID.ret" ]; do
+  sleep 1
+  n=${'$'}((n+1))
+  if [ ${'$'}n -ge 300 ]; then echo "su: timed out waiting for the host daemon"; rm -f "${'$'}R"; exit 1; fi
+done
+cat "${'$'}D/resp/${'$'}ID.out" 2>/dev/null
+RET=$(sed -n "s/^ret=//p" "${'$'}D/resp/${'$'}ID.ret" | head -n 1)
+rm -f "${'$'}R" "${'$'}D/resp/${'$'}ID.out" "${'$'}D/resp/${'$'}ID.ret"
+case "${'$'}RET" in ""|*[!0-9]*) RET=1;; esac
+exit "${'$'}RET"
+"""
+}
diff --git a/app/src/main/java/app/aemu/core/XposedManager.kt b/app/src/main/java/app/aemu/core/XposedManager.kt
new file mode 100644
index 0000000..a2a1894
--- /dev/null
+++ b/app/src/main/java/app/aemu/core/XposedManager.kt
@@ -0,0 +1,133 @@
+package app.aemu.core
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+
+/**
+ * Xposed-style module management for the guest, the VMOS way: a module is installed into the guest as a regular
+ * package (its APK goes to /data/aemu-xposed/modules/<pkg>.apk as well, for the loader of the next phase), and this
+ * manager keeps the registry — package, version, enabled flag, scope — in xposed.json next to the image. The VM's
+ * Modules panel edits the registry; with at least one enabled module the boot seeds the framework markers the
+ * module/manager apps look for (xposed.prop, XposedBridge.jar), so the firmware "sees" the framework.
+ *
+ * The in-process hooking itself (LSPlant, the same engine the foreign VMOS ships) is the next phase: it loads the
+ * enabled modules' dex into a scoped app's process and hands it the standard Xposed API. The registry and the file
+ * layout this manager owns are exactly what that loader consumes.
+ */
+class XposedManager(private val vm: GuestVm) {
+
+    data class Module(val pkg: String, val apk: String, val version: String, val enabled: Boolean, val scope: List<String>)
+
+    private val storeFile: File get() = File(vm.paths.bin, "xposed.json")
+    private val mods = LinkedHashMap<String, Module>()
+
+    init { load() }
+
+    @Synchronized private fun load() {
+        mods.clear()
+        runCatching {
+            val o = JSONObject(storeFile.takeIf { it.isFile }?.readText() ?: "{}")
+            val arr = o.optJSONArray("modules") ?: return
+            for (i in 0 until arr.length()) {
+                val m = arr.optJSONObject(i) ?: continue
+                val pkg = m.optString("pkg")
+                if (pkg.isEmpty()) continue
+                mods[pkg] = Module(pkg, m.optString("apk", modulesDir(pkg).path), m.optString("version", ""),
+                    m.optBoolean("enabled", true), m.optJSONArray("scope")?.let { s -> (0 until s.length()).map { s.optString(it) } } ?: emptyList())
+            }
+        }
+    }
+
+    @Synchronized private fun save() {
+        runCatching {
+            val arr = JSONArray()
+            for (m in mods.values) arr.put(JSONObject()
+                .put("pkg", m.pkg).put("apk", m.apk).put("version", m.version)
+                .put("enabled", m.enabled).put("scope", JSONArray(m.scope)))
+            storeFile.writeText(JSONObject().put("modules", arr).toString(2))
+        }
+    }
+
+    fun modulesDir(pkg: String = ""): File = File(File(vm.paths.root, "data/aemu-xposed"), "modules/$pkg")
+
+    @Synchronized fun list(): List<Module> = mods.values.toList()
+    @Synchronized fun find(pkg: String): Module? = mods[pkg]
+
+    @Synchronized fun add(pkg: String, apk: File, version: String) {
+        val dest = modulesDir(pkg)
+        dest.parentFile?.mkdirs()
+        runCatching { apk.copyTo(dest, overwrite = true) }
+        mods[pkg] = Module(pkg, dest.path, version, enabled = true, scope = emptyList())
+        save()
+        seedMarkers()
+        vm.log("xposed: module $pkg registered")
+    }
+
+    @Synchronized fun setEnabled(pkg: String, on: Boolean) {
+        val m = mods[pkg] ?: return
+        mods[pkg] = m.copy(enabled = on)
+        save()
+        seedMarkers()
+    }
+
+    /** which packages the module applies to (the module's own "recommended scope" is the seed); the LSPlant
+     *  loader of the next phase reads exactly this list */
+    @Synchronized fun setScope(pkg: String, scope: List<String>) {
+        val m = mods[pkg] ?: return
+        mods[pkg] = m.copy(scope = scope.filter { it.isNotBlank() }.distinct())
+        save()
+    }
+
+    /** the scope an Xposed module declares about itself (meta-data "xposedscope", assets/xposed_scope) */
+    fun moduleSelfScope(apk: File): List<String> = runCatching {
+        val pm = vm.ctx.packageManager
+        val info = pm.getPackageArchiveInfo(apk.absolutePath, android.content.pm.PackageManager.GET_META_DATA) ?: return emptyList()
+        val app = info.applicationInfo ?: return emptyList()
+        val declared = app.metaData?.getString("xposedscope")
+        val assets = apk.absolutePath.let { p ->
+            runCatching {
+                java.util.zip.ZipFile(p).use { z ->
+                    val e = z.getEntry("assets/xposed_scope") ?: return@use emptyList<String>()
+                    z.getInputStream(e).bufferedReader().readLines().filter { it.isNotBlank() }
+                }
+            }.getOrDefault(emptyList())
+        }
+        ((declared?.split(",") ?: emptyList()) + assets).map { it.trim() }.filter { it.isNotEmpty() }.distinct()
+    }.getOrDefault(emptyList())
+
+    @Synchronized fun remove(pkg: String) {
+        mods.remove(pkg)
+        save()
+        runCatching { modulesDir(pkg).deleteRecursively() }
+        seedMarkers()
+    }
+
+    /** The guest files the "is Xposed installed?" checks look at. Present while a module is enabled. */
+    fun seedMarkers() {
+        runCatching {
+            val any = mods.values.any { it.enabled }
+            val prop = File(vm.paths.root, "system/xposed.prop")
+            val bridge = File(vm.paths.root, "system/framework/XposedBridge.jar")
+            if (!any) { prop.delete(); bridge.delete(); return }
+            prop.parentFile?.mkdirs()
+            prop.writeText(
+                "version=93\n" +
+                    "versionCode=93\n" +
+                    "name=AEmulator Xposed compatibility\n" +
+                    "description=Modules are managed by the AEmulator app (VM menu → Modules); the LSPlant loader applies them per app\n")
+            if (!bridge.isFile) {
+                ZipOutputStream(bridge.outputStream()).use { z ->
+                    z.putNextEntry(ZipEntry("META-INF/MANIFEST.MF"))
+                    z.write("Manifest-Version: 1.0\nXposed-Bridge: AEmulator compat layer\n\n".toByteArray())
+                    z.closeEntry()
+                    z.putNextEntry(ZipEntry("assets/xposed_bridge_marker"))
+                    z.write("AEmulator Xposed compatibility layer\n".toByteArray())
+                    z.closeEntry()
+                }
+            }
+        }
+    }
+}
