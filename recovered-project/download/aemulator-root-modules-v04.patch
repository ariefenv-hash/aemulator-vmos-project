     fun guestShell(cmd: String, timeoutMs: Long = 60_000): String =
         guestRunner.run(listOf("/system/bin/sh", "-c", shellPrefix + cmd), timeoutMs).second
 
+    // ------------------------------------------------------------------ network diagnostics
+
+    /** What the guest network self-check reports; [verdict] turns it into one readable line. */
+    data class NetReport(
+        val dnsQueries: Long,
+        val dnsProp: String,
+        val resolvedIp: String?,
+        val dnsOk: Boolean,
+        val icmpOk: Boolean,
+        val rawName: String,
+        val rawIp: String,
+    ) {
+        fun verdict(): String = when {
+            !dnsOk -> "DNS is broken: the guest cannot resolve names (the dnsproxyd bridge is not answering — try “Restart netd” below)"
+            icmpOk -> "network OK: names resolve and ICMP replies come back"
+            else -> "DNS OK, but ping gets no replies — engines often filter ICMP; TCP (browsers, apps) can still work"
+        }
+    }
+
+    /**
+     * Guest-side network probe. Name resolution in the sandbox can only happen through our dnsproxyd
+     * bridge (the guest's own netd has no per-network marks to resolve through), so a resolved name
+     * proves the bridge works; the IP ping tells whether ICMP passes the engine at all.
+     */
+    fun networkReport(): NetReport {
+        val dnsProp = runCatching { guestShell("getprop net.dns1", 20_000).trim().lines().firstOrNull { it.isNotBlank() } ?: "" }.getOrDefault("")
+        val rawName = runCatching { guestShell("ping -c 1 -W 3 gstatic.com", 40_000).trim() }.getOrDefault("")
+        val resolvedIp = Regex("""PING \S+ \(([\d.]+)\)""").find(rawName)?.groupValues?.get(1)
+        val rawIp = runCatching { guestShell("ping -c 1 -W 3 8.8.8.8", 40_000).trim() }.getOrDefault("")
+        val got = Regex("""[,,]\s*1\s+received|0%\s+packet\s+loss""").containsMatchIn(rawIp)
+        return NetReport(
+            dnsQueries = dns.queries,
+            dnsProp = dnsProp,
+            resolvedIp = resolvedIp,
+            dnsOk = resolvedIp != null,
+            icmpOk = got,
+            rawName = rawName,
+            rawIp = rawIp,
+        )
+    }
+
+    /** A one-line self-check into the VM log shortly after the boot completes, so a silent network
+     *  break (a firmware, an engine or a third-party change) is visible in the log at once. */
+    private fun networkSelfCheck() {
+        // wait for ConnectivityService and friends to actually settle before judging
+        for (wait in longArrayOf(8_000, 15_000)) {
+            Thread.sleep(wait)
+            if (state != State.RUNNING) return
+            val r = runCatching { networkReport() }.getOrNull() ?: return
+            val dnsState = if (r.dnsOk) "resolve ok (${r.resolvedIp})" else "no resolution"
+            val icmpState = if (r.icmpOk) "ping ok" else "no ping replies"
+            log("net self-check: dns proxy seen ${r.dnsQueries} queries, guest: $dnsState, $icmpState${if (!r.dnsOk) " ← network seems broken, see VM menu → Network" else ""}")
+            if (r.dnsOk) return   // one good report is enough
+        }
+    }
+
+    /** the “Restart netd” of the Network panel: the guest re-creates the socket, dns.ensure() takes it over again */
+    fun restartGuestNet() {
+        runCatching { guestShell("setprop ctl.restart netd", 60_000) }
+        Thread.sleep(2_000)
+        runCatching { dns.ensure() }
+        log("net: netd restarted, dnsproxyd bridge re-taken")
+    }
